---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Enclave Compute" description="The page you were looking for could not be found.">
  <section class="hero">
    <div class="badge">404 — Page not found</div>
    <h1>This page took a <span class="highlight">private</span> exit</h1>
    <p>
      The page you were looking for doesn't exist or may have moved. Let's get you
      back to something useful.
    </p>
    <div class="btn-group">
      <a href="/" class="btn btn-primary">Back to home</a>
      <a href="/#contact" class="btn btn-outline">Get in touch</a>
    </div>
  </section>
</Base>
