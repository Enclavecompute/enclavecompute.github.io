---
import Base from '../layouts/Base.astro';
---

<Base title="Enclave Compute — AI That Never Leaves Your Building">
  <!-- HERO -->
  <section class="hero">
    <div class="badge">🔒 Private AI, deployed your way</div>
    <h1>Your <span class="highlight">AI enablement</span> partner</h1>
    <p>
      We help healthcare practices, law firms, and professional services adopt AI with
      confidence. Local, on-premise AI is our specialty — but we guide you across your
      entire AI journey, from strategy to deployment.
    </p>
    <div class="btn-group">
      <a href="#contact" class="btn btn-primary">Book a Free Demo</a>
      <a href="#what-we-do" class="btn btn-outline">See What We Do</a>
    </div>
  </section>

  <!-- WHAT WE DO / AI ENABLERS -->
  <section id="what-we-do">
    <h2>What we do</h2>
    <p class="section-subtitle">
      We're AI enablers. Local AI is where we go deepest, but we meet you wherever you
      are — and grow with you.
    </p>
    <div class="enabler-grid">
      <div class="enabler-card primary">
        <span class="tag">Our specialty</span>
        <div class="icon">🔒</div>
        <h3>Local AI Deployment</h3>
        <p>Private, on-premise AI for your most sensitive workflows. Your data never leaves your building.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">☁️</div>
        <h3>Cloud AI Adoption</h3>
        <p>Where privacy allows, we help you pick, configure, and safely roll out cloud AI tools.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🔗</div>
        <h3>Integrations</h3>
        <p>Connect AI to the systems you already run — EHR, scheduling, billing, and document stores.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">📈</div>
        <h3>AI Strategy & Training</h3>
        <p>An AI roadmap, staff training, and change management so your team actually adopts it.</p>
      </div>
    </div>
  </section>

  <!-- WHY LOCAL -->
  <section>
    <h2>Why local AI?</h2>
    <p class="section-subtitle">
      Cloud AI sends your sensitive data to external servers. We keep everything on a device in your office.
    </p>
    <div class="feature-grid">
      <div class="feature-card">
        <div class="icon">🔐</div>
        <h3>Complete Data Privacy</h3>
        <p>Patient records, client files, and privileged communications never leave your network. No cloud APIs, no third-party data processing.</p>
      </div>
      <div class="feature-card">
        <div class="icon">⚡</div>
        <h3>No Per-User Fees</h3>
        <p>One-time deployment. No monthly SaaS subscriptions that scale with your headcount. The hardware is yours.</p>
      </div>
      <div class="feature-card">
        <div class="icon">🏥</div>
        <h3>Compliance Simplified</h3>
        <p>No Business Associate Agreements with cloud AI vendors. No vendor risk assessments. Your compliance officer will thank you.</p>
      </div>
      <div class="feature-card">
        <div class="icon">🛡️</div>
        <h3>No Vendor Lock-In</h3>
        <p>Open-source models on hardware you own. If you part ways with us, everything keeps running. Your data, your hardware, your choice.</p>
      </div>
      <div class="feature-card">
        <div class="icon">📡</div>
        <h3>Works Offline</h3>
        <p>Internet goes down? Your AI keeps working. No cloud dependency means no outages, no latency spikes, no downtime.</p>
      </div>
      <div class="feature-card">
        <div class="icon">🤝</div>
        <h3>Local Support</h3>
        <p>We're based in the Triangle, NC. When you need help, we're 20 minutes away — not a ticket queue in another timezone.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works">
    <h2>How it works</h2>
    <p class="section-subtitle">From first conversation to running AI in your office — in under two weeks.</p>
    <div class="steps">
      <div class="step">
        <h3>Discovery Call</h3>
        <p>We learn your workflows, pain points, and compliance requirements. No cost, no commitment.</p>
      </div>
      <div class="step">
        <h3>Free Insight Report</h3>
        <p>We deliver a sample AI analysis using your public data (e.g., review intelligence) so you can see the value before you buy.</p>
      </div>
      <div class="step">
        <h3>On-Site Deployment</h3>
        <p>We install a pre-configured device in your office, set up the AI models for your use cases, and configure access controls.</p>
      </div>
      <div class="step">
        <h3>Staff Training & Go-Live</h3>
        <p>90-minute on-site training. Your team is productive on day one. 30 days of included support.</p>
      </div>
    </div>

    <div class="arch-visual">
      <div class="arch-box arch-office">
        <div class="arch-label">Your Office</div>
        <div class="arch-node arch-devices">
          <span class="arch-icon">💻</span>
          <strong>Staff Devices</strong>
          <small>Laptop, tablet, or phone — any browser</small>
        </div>
        <div class="arch-arrow">↓ Office Wi-Fi (LAN only)</div>
        <div class="arch-node arch-appliance">
          <span class="arch-icon">🖥️</span>
          <strong>Local AI Appliance</strong>
          <small>Models · Transcription · Vector Store · Encryption</small>
        </div>
        <div class="arch-footer">☁️ Internet? Not required.</div>
      </div>
    </div>
  </section>

  <!-- PII GUARD -->
  <section id="pii-guard">
    <h2>Safe Internet Mode</h2>
    <p class="section-subtitle">
      Local-first doesn't have to mean offline-only. When your workflows need internet access, PII Guard keeps sensitive data from ever leaving your network.
    </p>
    <div class="pii-grid">
      <div class="pii-visual">
        <div class="pii-flow">
          <div class="pii-node pii-staff">
            <span class="arch-icon">💬</span>
            <strong>Staff prompt</strong>
            <small>"Summarize Mrs. Johnson's chart for the referral letter"</small>
          </div>
          <div class="arch-arrow">↓</div>
          <div class="pii-node pii-guard-node">
            <span class="arch-icon">🛡️</span>
            <strong>PII Guard</strong>
            <small>Names, DOBs, SSNs, phone numbers stripped before any external call</small>
          </div>
          <div class="arch-arrow">↓ Sanitized request</div>
          <div class="pii-node pii-external">
            <span class="arch-icon">☁️</span>
            <strong>External Service</strong>
            <small>Sees only de-identified data</small>
          </div>
          <div class="arch-arrow">↓ Response</div>
          <div class="pii-node pii-rehydrate">
            <span class="arch-icon">🔄</span>
            <strong>Re-identification</strong>
            <small>Original names and details restored locally — never exposed</small>
          </div>
        </div>
      </div>
      <div class="pii-features">
        <div class="feature-card">
          <div class="icon">🔍</div>
          <h3>Automatic PII Detection</h3>
          <p>Patient names, dates of birth, Social Security numbers, phone numbers, and addresses are detected and stripped before any data leaves your device.</p>
        </div>
        <div class="feature-card">
          <div class="icon">📋</div>
          <h3>Full Audit Trail</h3>
          <p>Every outbound request is logged — what was sent, what was redacted, and when. Your compliance officer can review anytime.</p>
        </div>
        <div class="feature-card">
          <div class="icon">🔒</div>
          <h3>Allowlisted Services Only</h3>
          <p>The practice admin controls exactly which external services are permitted. Default is fully offline — internet access is opt-in, per use case.</p>
        </div>
        <div class="feature-card">
          <div class="icon">⚡</div>
          <h3>Best of Both Worlds</h3>
          <p>Get the power of cloud AI for research, letter drafting, and communication — with the privacy guarantees of a local-first system.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VERTICALS -->
  <section id="verticals">
    <h2>Who we work with</h2>
    <p class="section-subtitle">
      Any business that handles sensitive data and wants AI without the cloud risk.
    </p>
    <div class="vertical-cards">
      <div class="vertical-card">
        <h3>🏥 Healthcare</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Dental, orthodontic, and medical practices</p>
        <ul>
          <li>Clinical note drafting (SOAP notes from voice)</li>
          <li>Patient review intelligence & response</li>
          <li>Pre-authorization letter drafting</li>
          <li>Morning huddle briefs</li>
          <li>Staff knowledge base</li>
        </ul>
      </div>
      <div class="vertical-card">
        <h3>⚖️ Legal</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Solo practitioners and small firms</p>
        <ul>
          <li>Contract review & clause extraction</li>
          <li>Deposition summarization</li>
          <li>Case research assistance</li>
          <li>Client communication drafting</li>
          <li>Document organization & search</li>
        </ul>
      </div>
      <div class="vertical-card">
        <h3>🏢 Professional Services</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Accounting, consulting, financial advisory</p>
        <ul>
          <li>Client report generation</li>
          <li>Document summarization</li>
          <li>Internal knowledge base</li>
          <li>Review monitoring & response</li>
          <li>Process automation</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <h2>About Enclave Compute</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>
          Enclave Compute is an AI enablement consultancy based in the Triangle area of North Carolina.
          We help privacy-sensitive businesses adopt AI on their terms — with local, on-premise
          deployment as our specialty for the workflows where data privacy matters most.
        </p>
        <p>
          Founded by engineers with backgrounds in enterprise data security, healthcare data systems,
          and applied AI — we understand both the technology and the compliance requirements
          that come with handling sensitive data.
        </p>
        <p>
          We believe AI should work for your business on your terms, running on hardware you own,
          with data that never leaves your control.
        </p>
      </div>
      <div class="about-highlights">
        <div class="about-highlight">
          <h4>🔬 Technical Depth</h4>
          <p>Background in enterprise data security, healthcare data systems, and production AI deployments.</p>
        </div>
        <div class="about-highlight">
          <h4>📍 Triangle, NC</h4>
          <p>Local presence means on-site deployments, in-person training, and same-day support.</p>
        </div>
        <div class="about-highlight">
          <h4>🧱 Open Source Stack</h4>
          <p>Built on proven open-source models (Gemma, Whisper, Llama). No proprietary lock-in.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="cta-section" id="contact">
      <h2>Ready to see it in action?</h2>
      <p>Book a free demo and we'll show you what local AI can do — using your own data, on a device with no internet connection.</p>
      <a href="mailto:hello@enclavecompute.net" class="btn btn-primary">hello@enclavecompute.net</a>
    </div>
  </section>
</Base>
