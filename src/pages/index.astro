---
import Base from '../layouts/Base.astro';

const siteUrl = 'https://www.enclavecompute.net';
const serviceAreas = ['Raleigh', 'Durham', 'Chapel Hill', 'Cary', 'Garner'].map((name) => ({
  '@type': 'City',
  name: `${name}, NC`,
}));
serviceAreas.push({ '@type': 'AdministrativeArea', name: 'Research Triangle, NC' });

const faqItems = [
  {
    question: 'Do you recommend cloud AI or local AI?',
    answer:
      'It depends on the workflow. ChatGPT Business and other cloud tools are often the fastest fit for everyday research, writing, and operations. When a workflow involves highly sensitive data, offline operation, or tighter infrastructure control, we can add de-identification, stronger access controls, or local execution.',
  },
  {
    question: 'What does a good first AI project look like?',
    answer:
      'It solves one measurable problem, uses clearly approved data, produces an output a person can review, and leaves your staff able to run the workflow without us. We start small, measure the result, and expand only when the first workflow earns trust.',
  },
  {
    question: 'Can you keep sensitive workflows off the public cloud?',
    answer:
      'Yes. Selected workflows can run on hardware inside your office with local models and access controls. Local execution reduces external data exposure, but it still requires sound device security, backups, permissions, policies, and human review.',
  },
  {
    question: 'How quickly can we launch something useful?',
    answer:
      'A bounded first workflow can often be targeted for launch within two weeks after requirements, data access, and owner approvals are ready. Integrations, regulated data, and custom infrastructure can require more time.',
  },
];

const structuredData = [
  {
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}/#service`,
    name: 'Enclave Compute',
    description:
      'Practical AI workflow consulting, automation, training, and private deployment for small businesses in the Research Triangle, NC.',
    url: siteUrl,
    email: 'info@enclavecompute.net',
    logo: `${siteUrl}/logo.png`,
    image: `${siteUrl}/logo.png`,
    parentOrganization: { '@id': `${siteUrl}/#organization` },
    areaServed: serviceAreas,
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}/#faq`,
    mainEntity: faqItems.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<Base
  title="Practical AI Consulting in Raleigh, NC | Enclave Compute"
  description="Turn one painful workflow at a time into a useful AI capability. Enclave Compute helps Triangle businesses adopt cloud, automated, and private AI safely."
  structuredData={structuredData}
>
  <!-- HERO -->
  <section class="hero">
    <div class="badge">Practical AI for Triangle businesses</div>
    <h1>Put AI to work—<span class="highlight">without losing control</span> of your data</h1>
    <p>
      We help small businesses choose, deploy, and adopt the right AI for each workflow—from
      ChatGPT Business and automation to private, on-premise AI when sensitive data demands it.
    </p>
    <div class="btn-group">
      <a href="#contact" class="btn btn-primary">Start with a 20-minute call</a>
      <a href="#workflows" class="btn btn-outline">See example workflows</a>
    </div>
  </section>

  <!-- WHAT WE DO / AI ENABLERS -->
  <section id="what-we-do">
    <h2>What we do</h2>
    <p class="section-subtitle">
      Start with one useful workflow. Choose the simplest safe tool. Train your team to own it.
    </p>
    <div class="enabler-grid">
      <div class="enabler-card primary">
        <span class="tag">Start here</span>
        <div class="icon">🧭</div>
        <h3>Workflow Discovery & Training</h3>
        <p>Find a high-value first use case, define safe data boundaries, build it with your team, and measure what changes.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">☁️</div>
        <h3>Cloud AI Adoption</h3>
        <p>Configure ChatGPT Business and other cloud tools for everyday research, writing, analysis, and operations.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🔗</div>
        <h3>Automation & Integrations</h3>
        <p>Connect approved AI workflows to the documents and systems your team already uses—with human review at consequential steps.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🔒</div>
        <h3>Private AI Deployment</h3>
        <p>Run selected sensitive or offline workflows on hardware you control, with local models and scoped access.</p>
        <a class="text-link" href="/services/on-premise-ai/">Explore private AI deployment →</a>
      </div>
    </div>
  </section>

  <!-- DEPLOYMENT CHOICES -->
  <section id="workflows">
    <h2>Choose the right deployment for the workflow</h2>
    <p class="section-subtitle">
      We are not local-only or cloud-only. We match the architecture to the data, consequence, and operating reality.
    </p>
    <div class="choice-grid">
      <div class="feature-card">
        <div class="choice-kicker">Everyday work</div>
        <div class="icon">☁️</div>
        <h3>Cloud workbench</h3>
        <p>Use managed business AI for research, drafting, marketing, and operations when the data and policy allow it.</p>
      </div>
      <div class="feature-card">
        <div class="choice-kicker">Repeatable processes</div>
        <div class="icon">🔗</div>
        <h3>Connected automation</h3>
        <p>Turn approved inputs into reviewable outputs and connect them to existing systems without hiding the decision points.</p>
      </div>
      <div class="feature-card">
        <div class="choice-kicker">Sensitive or offline work</div>
        <div class="icon">🔒</div>
        <h3>Private execution</h3>
        <p>Keep selected workflows on your network when confidentiality, resilience, or infrastructure control outweighs cloud convenience.</p>
      </div>
    </div>
    <div class="principle-strip">
      <span><strong>Bounded:</strong> one clear workflow</span>
      <span><strong>Reviewable:</strong> people remain accountable</span>
      <span><strong>Measurable:</strong> time, quality, or revenue impact</span>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works">
    <h2>How it works</h2>
    <p class="section-subtitle">From first conversation to a bounded workflow your team can run and evaluate.</p>
    <div class="steps">
      <div class="step">
        <h3>Free Intro Call</h3>
        <p>A 20-minute call to understand your workflows and see if we're a fit. No cost, no commitment.</p>
      </div>
      <div class="step">
        <h3>AI Readiness Assessment</h3>
        <p>A fixed-fee engagement: we audit your workflows, deliver a written plan, and demo AI live on your own data — credited toward your project if you move forward.</p>
      </div>
      <div class="step">
        <h3>Build the First Workflow</h3>
        <p>We configure the selected cloud, automation, or private-AI path and document its data, review, and approval boundaries.</p>
      </div>
      <div class="step">
        <h3>Staff Training & Go-Live</h3>
        <p>Hands-on training teaches your team how to operate, review, and improve the first workflow. 30 days of included support.</p>
      </div>
    </div>

    <div class="arch-visual">
      <div class="arch-box arch-office">
        <div class="arch-label">Your Workflow</div>
        <div class="arch-node arch-devices">
          <span class="arch-icon">💻</span>
          <strong>Staff Devices</strong>
          <small>Laptop, tablet, or phone — any browser</small>
        </div>
        <div class="arch-arrow">↓ Approved access path</div>
        <div class="arch-node arch-appliance">
          <span class="arch-icon">🖥️</span>
          <strong>Right-sized AI Workflow</strong>
          <small>Cloud · Automation · Private execution</small>
        </div>
        <div class="arch-footer">One workflow · Clear boundaries · Human review</div>
      </div>
    </div>
  </section>

  <!-- PII GUARD -->
  <section id="pii-guard">
    <h2>Safe Internet Mode</h2>
    <p class="section-subtitle">
      Local-first doesn't have to mean offline-only. For approved external calls, PII Guard reduces exposure by detecting and redacting configured identifiers before a request leaves your network.
    </p>
    <div class="pii-grid">
      <div class="pii-visual">
        <div class="pii-flow">
          <div class="pii-node pii-staff">
            <span class="arch-icon">💬</span>
            <strong>Staff prompt</strong>
            <small>"Summarize Mrs. Johnson's chart for the referral letter"</small>
          </div>
          <div class="arch-arrow">↓</div>
          <div class="pii-node pii-guard-node">
            <span class="arch-icon">🛡️</span>
            <strong>PII Guard</strong>
            <small>Configured identifiers detected and redacted before an approved external call</small>
          </div>
          <div class="arch-arrow">↓ Sanitized request</div>
          <div class="pii-node pii-external">
            <span class="arch-icon">☁️</span>
            <strong>External Service</strong>
            <small>Sees only de-identified data</small>
          </div>
          <div class="arch-arrow">↓ Response</div>
          <div class="pii-node pii-rehydrate">
            <span class="arch-icon">🔄</span>
            <strong>Re-identification</strong>
            <small>Mapped details restored locally after the response returns</small>
          </div>
        </div>
      </div>
      <div class="pii-features">
        <div class="feature-card">
          <div class="icon">🔍</div>
          <h3>Automatic PII Detection</h3>
          <p>Configured identifier types—including names, dates of birth, phone numbers, and addresses—can be detected and redacted before approved external calls.</p>
        </div>
        <div class="feature-card">
          <div class="icon">📋</div>
          <h3>Full Audit Trail</h3>
          <p>Approved outbound workflows can record what was sent, what was redacted, and when for later review.</p>
        </div>
        <div class="feature-card">
          <div class="icon">🔒</div>
          <h3>Allowlisted Services Only</h3>
          <p>The practice admin controls exactly which external services are permitted. Default is fully offline — internet access is opt-in, per use case.</p>
        </div>
        <div class="feature-card">
          <div class="icon">⚡</div>
          <h3>Best of Both Worlds</h3>
          <p>Use cloud capabilities selectively while retaining the privacy advantages of a local-first design. Redaction reduces risk; it is not a compliance guarantee.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VERTICALS -->
  <section id="verticals">
    <h2>Where we start</h2>
    <p class="section-subtitle">
      Bounded, reviewable workflows for small teams that handle customer, patient, client, or operational data.
    </p>
    <div class="vertical-cards">
      <div class="vertical-card">
        <h3>🏥 Healthcare</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Dental, orthodontic, and medical practices</p>
        <ul>
          <li>Clinical note drafting (SOAP notes from voice)</li>
          <li>Patient review intelligence & response</li>
          <li>Pre-authorization letter drafting</li>
          <li>Morning huddle briefs</li>
          <li>Staff knowledge base</li>
        </ul>
        <a class="text-link" href="/industries/healthcare-ai/">AI for healthcare practices →</a>
      </div>
      <div class="vertical-card">
        <h3>⚖️ Legal</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Solo practitioners and small firms</p>
        <ul>
          <li>Contract review & clause extraction</li>
          <li>Deposition summarization</li>
          <li>Case research assistance</li>
          <li>Client communication drafting</li>
          <li>Document organization & search</li>
        </ul>
        <a class="text-link" href="/industries/legal-ai/">AI for law firms →</a>
      </div>
      <div class="vertical-card">
        <h3>🏢 Professional Services</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Accounting, consulting, financial advisory</p>
        <ul>
          <li>Client report generation</li>
          <li>Document summarization</li>
          <li>Internal knowledge base</li>
          <li>Review monitoring & response</li>
          <li>Process automation</li>
        </ul>
        <a class="text-link" href="/industries/professional-services-ai/">AI for professional services →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <h2>About Enclave Compute</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>
          Enclave Compute is a Garner-based AI enablement consultancy serving the Research Triangle.
          We help small teams move from AI interest to one useful, governed workflow their staff can operate.
        </p>
        <p>
          Our team brings product and engineering experience across payments, cloud security,
          confidential computing, healthcare data platforms, and applied AI.
        </p>
        <p>
          We are vendor-pragmatic: use a managed cloud tool when it is the simplest safe choice;
          use stronger controls or private execution when the workflow requires them.
        </p>
        <p class="fine-print">Enclave Compute is an independent venture. Employer affiliations do not imply sponsorship or endorsement.</p>
      </div>
      <div class="about-highlights">
        <div class="about-highlight">
          <h4>🔬 Technical Depth</h4>
          <p>Hands-on prototypes, evaluation harnesses, workflow automation, privacy controls, and enterprise security experience.</p>
        </div>
        <div class="about-highlight">
          <h4>📍 Triangle, NC</h4>
          <p>Local discovery, scheduled on-site delivery, in-person training, and practical follow-through.</p>
        </div>
        <div class="about-highlight">
          <h4>⚖️ Fit Over Fashion</h4>
          <p>Cloud, automation, or local models—selected according to business value, data sensitivity, and operating constraints.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section id="proof">
    <h2>Built and tested, not just advised</h2>
    <p class="section-subtitle">Our current proof-of-work is a tested prototype kit, not a claim of completed client deployments.</p>
    <div class="proof-grid">
      <div class="proof-number">7/7</div>
      <div>
        <h3>Representative workflow checks passed</h3>
        <p>Our selected local model passed rubric checks across seven synthetic-data workflows, including review analysis, document drafting, contract review, and voice-to-note generation.</p>
      </div>
      <div class="proof-number">13.5s</div>
      <div>
        <h3>Average response time in the selected evaluation</h3>
        <p>We compared five local models instead of choosing by reputation. The harness exposed concrete quality and privacy failures in alternatives and gave us an evidence-based starting point.</p>
      </div>
    </div>
    <p class="fine-print">Prototype results from controlled tests using synthetic inputs. They do not predict performance for every client workflow; each deployment requires its own acceptance criteria and human review.</p>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <h2>Frequently asked questions</h2>
    <p class="section-subtitle">The essentials about choosing and launching a useful first AI workflow.</p>
    <div class="faq-list">
      {faqItems.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="cta-section" id="contact">
      <h2>Start with one workflow</h2>
      <p>Email us to schedule a free 20-minute conversation. If there is a fit, a fixed-fee AI Readiness Assessment maps the workflow, data boundaries, success measure, and recommended deployment path.</p>
      <a href="mailto:info@enclavecompute.net?subject=Enclave%20Compute%20intro%20call" class="btn btn-primary">Email us to schedule</a>
      <p class="contact-email">info@enclavecompute.net</p>
    </div>
  </section>
</Base>
