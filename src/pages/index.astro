---
import Base from '../layouts/Base.astro';

const siteUrl = 'https://www.enclavecompute.net';
const serviceAreas = ['Raleigh', 'Durham', 'Chapel Hill', 'Cary', 'Garner'].map((name) => ({
  '@type': 'City',
  name: `${name}, NC`,
}));
serviceAreas.push({ '@type': 'AdministrativeArea', name: 'Research Triangle, NC' });

const faqItems = [
  {
    question: 'What can AI improve in a small business?',
    answer:
      'The best opportunities are usually repetitive, information-heavy tasks: finding answers across documents, drafting routine communications, summarizing meetings, preparing reports, extracting information, and moving work between systems. We look for a clear burden, a reviewable output, and a result worth measuring.',
  },
  {
    question: 'Do we need to replace the tools we already use?',
    answer:
      'Usually not. We prefer to configure and connect tools around the way your team already works. A good first project should reduce friction rather than force a broad software migration.',
  },
  {
    question: 'How do you handle sensitive data?',
    answer:
      'We define approved data and access boundaries before building. Depending on the workflow, controls can include business-grade accounts, restricted access, redaction, audit trails, human approval, or private infrastructure. The goal is the simplest approach that fits the actual risk.',
  },
  {
    question: 'How quickly can we launch something useful?',
    answer:
      'A bounded first workflow can often be targeted for launch within two weeks after requirements, data access, and owner approvals are ready. Integrations, regulated data, and custom infrastructure can require more time.',
  },
];

const structuredData = [
  {
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}/#service`,
    name: 'Enclave Compute',
    description:
      'Practical AI consulting, workflow automation, and team training for small businesses in the Research Triangle, NC.',
    url: siteUrl,
    email: 'info@enclavecompute.net',
    logo: `${siteUrl}/logo.png`,
    image: `${siteUrl}/logo.png`,
    parentOrganization: { '@id': `${siteUrl}/#organization` },
    areaServed: serviceAreas,
  },
  {
    '@type': 'FAQPage',
    '@id': `${siteUrl}/#faq`,
    mainEntity: faqItems.map(({ question, answer }) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<Base
  title="Practical AI Consulting in Raleigh, NC | Enclave Compute"
  description="Enclave Compute helps Triangle small businesses find useful AI opportunities, automate repetitive work, and train teams to adopt AI with confidence."
  structuredData={structuredData}
>
  <section class="hero">
    <div class="badge">Practical AI for Triangle businesses</div>
    <h1>Turn repetitive work into <span class="highlight">useful AI workflows</span></h1>
    <p>
      We help small businesses identify the right opportunities, configure the tools, automate the
      handoffs, and train their teams—starting with one workflow that can prove its value.
    </p>
    <div class="btn-group">
      <a href="#contact" class="btn btn-primary">Start with a 20-minute call</a>
      <a href="#workflows" class="btn btn-outline">See example workflows</a>
    </div>
  </section>

  <section id="what-we-do">
    <h2>From AI interest to everyday use</h2>
    <p class="section-subtitle">
      Strategy, implementation, and adoption in one practical engagement.
    </p>
    <div class="enabler-grid">
      <div class="enabler-card primary">
        <span class="tag">Start here</span>
        <div class="icon">🧭</div>
        <h3>Opportunity Mapping</h3>
        <p>Find the work where AI can save time, improve consistency, or help your team respond faster.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🛠️</div>
        <h3>Workflow Implementation</h3>
        <p>Configure the right business AI tools and turn a promising use case into a repeatable process.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🔗</div>
        <h3>Automation & Integration</h3>
        <p>Connect approved inputs, documents, and systems while keeping consequential decisions visible to people.</p>
      </div>
      <div class="enabler-card">
        <div class="icon">🎓</div>
        <h3>Team Training & Adoption</h3>
        <p>Give staff hands-on practice, clear usage boundaries, and the confidence to improve the workflow over time.</p>
      </div>
    </div>
  </section>

  <section id="workflows">
    <h2>What a useful first workflow can look like</h2>
    <p class="section-subtitle">
      Start with a real business burden—not a technology shopping list.
    </p>
    <div class="choice-grid">
      <div class="feature-card">
        <div class="choice-kicker">Find</div>
        <div class="icon">🔎</div>
        <h3>Make knowledge easier to use</h3>
        <p>Help staff find grounded answers across approved policies, procedures, prior work, and reference documents.</p>
      </div>
      <div class="feature-card">
        <div class="choice-kicker">Create</div>
        <div class="icon">✍️</div>
        <h3>Prepare reviewable first drafts</h3>
        <p>Turn source material into reports, summaries, routine communications, and other drafts your team can check.</p>
      </div>
      <div class="feature-card">
        <div class="choice-kicker">Move</div>
        <div class="icon">⚙️</div>
        <h3>Automate repetitive handoffs</h3>
        <p>Extract information, create follow-up tasks, and route approved outputs into the systems your team already uses.</p>
      </div>
    </div>
    <div class="principle-strip">
      <span><strong>Bounded:</strong> one clear workflow</span>
      <span><strong>Reviewable:</strong> people remain accountable</span>
      <span><strong>Measurable:</strong> time, quality, or revenue impact</span>
    </div>
  </section>

  <section id="how-it-works">
    <h2>How it works</h2>
    <p class="section-subtitle">A small first engagement, built to produce evidence instead of a long transformation plan.</p>
    <div class="steps">
      <div class="step">
        <h3>Free Intro Call</h3>
        <p>A 20-minute conversation about where work gets stuck and whether there is a useful place to begin.</p>
      </div>
      <div class="step">
        <h3>AI Readiness Assessment</h3>
        <p>A fixed-fee workflow audit, written recommendation, and live demonstration—credited toward the project if you continue.</p>
      </div>
      <div class="step">
        <h3>Build the First Workflow</h3>
        <p>We configure the tools, document the inputs and review points, and test the workflow against agreed acceptance criteria.</p>
      </div>
      <div class="step">
        <h3>Train, Launch, Improve</h3>
        <p>Your staff learns to operate and review the workflow, with 30 days of included support after launch.</p>
      </div>
    </div>
  </section>

  <section id="responsible-ai">
    <h2>Practical controls, matched to the risk</h2>
    <p class="section-subtitle">
      Responsible implementation is part of the workflow—not a policy document added at the end.
    </p>
    <div class="feature-grid">
      <div class="feature-card">
        <div class="icon">📥</div>
        <h3>Approved inputs</h3>
        <p>Define what data the workflow may use, who can access it, and where it is allowed to go.</p>
      </div>
      <div class="feature-card">
        <div class="icon">👤</div>
        <h3>Human checkpoints</h3>
        <p>Keep people accountable for customer-facing, clinical, legal, financial, and other consequential outputs.</p>
      </div>
      <div class="feature-card">
        <div class="icon">🛡️</div>
        <h3>Right-sized safeguards</h3>
        <p>Use business-grade accounts, access controls, redaction, auditability, or private deployment when the workflow warrants it.</p>
        <a class="text-link" href="/services/on-premise-ai/">When private deployment is the right fit →</a>
      </div>
    </div>
  </section>

  <section id="verticals">
    <h2>Where we work</h2>
    <p class="section-subtitle">
      Practical workflows for small teams that handle customer, patient, client, or operational information.
    </p>
    <div class="vertical-cards">
      <div class="vertical-card">
        <h3>🏥 Healthcare</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Dental, orthodontic, and medical practices</p>
        <ul>
          <li>Documentation first drafts</li>
          <li>Patient communication support</li>
          <li>Morning huddle briefs</li>
          <li>Staff knowledge search</li>
          <li>Administrative workflow automation</li>
        </ul>
        <a class="text-link" href="/industries/healthcare-ai/">AI for healthcare practices →</a>
      </div>
      <div class="vertical-card">
        <h3>⚖️ Legal</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Solo practitioners and small firms</p>
        <ul>
          <li>Document review and summarization</li>
          <li>Contract clause extraction</li>
          <li>Case knowledge search</li>
          <li>Client communication drafts</li>
          <li>Administrative workflow automation</li>
        </ul>
        <a class="text-link" href="/industries/legal-ai/">AI for law firms →</a>
      </div>
      <div class="vertical-card">
        <h3>🏢 Professional Services</h3>
        <p style="color: var(--color-text-muted); margin-bottom: 1rem;">Accounting, consulting, and advisory teams</p>
        <ul>
          <li>Client report first drafts</li>
          <li>Meeting and document summaries</li>
          <li>Internal knowledge search</li>
          <li>Lead and inquiry follow-up</li>
          <li>Process automation</li>
        </ul>
        <a class="text-link" href="/industries/professional-services-ai/">AI for professional services →</a>
      </div>
    </div>
  </section>

  <section id="about">
    <h2>About Enclave Compute</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>
          Enclave Compute is a Garner-based AI enablement consultancy serving the Research Triangle.
          We help small teams move from experimentation to one useful workflow their staff can operate and improve.
        </p>
        <p>
          Our team brings product and engineering experience across payments, enterprise security,
          healthcare data platforms, cloud systems, workflow automation, and applied AI.
        </p>
        <p>
          We recommend tools based on business value, ease of adoption, data requirements, and operating constraints—not vendor loyalty or technical fashion.
        </p>
        <p class="fine-print">Enclave Compute is an independent venture. Employer affiliations do not imply sponsorship or endorsement.</p>
      </div>
      <div class="about-highlights">
        <div class="about-highlight">
          <h4>🔬 Built and Tested</h4>
          <p>We use prototypes, evaluation criteria, and workflow testing before asking a team to rely on a solution.</p>
        </div>
        <div class="about-highlight">
          <h4>📍 Triangle, NC</h4>
          <p>Local discovery, scheduled on-site delivery, in-person training, and practical follow-through.</p>
        </div>
        <div class="about-highlight">
          <h4>⚖️ Fit Over Fashion</h4>
          <p>The right tool is the one your team can use safely, affordably, and repeatedly.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="faq">
    <h2>Frequently asked questions</h2>
    <p class="section-subtitle">The essentials about choosing and launching a useful first AI workflow.</p>
    <div class="faq-list">
      {faqItems.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section>
    <div class="cta-section" id="contact">
      <h2>Start with one workflow</h2>
      <p>Email us to schedule a free 20-minute conversation. If there is a fit, a fixed-fee AI Readiness Assessment maps the opportunity, current process, data boundaries, success measure, and recommended next step.</p>
      <a href="mailto:info@enclavecompute.net?subject=Enclave%20Compute%20intro%20call" class="btn btn-primary">Email us to schedule</a>
      <p class="contact-email">info@enclavecompute.net</p>
    </div>
  </section>
</Base>
