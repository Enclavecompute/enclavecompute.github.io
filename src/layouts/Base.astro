---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Enclave Compute — Local AI deployment for privacy-sensitive businesses. Your data never leaves your building.' } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/logo.png', Astro.site); // Fallback to logo until a specific OG image is added

const siteUrl = 'https://www.enclavecompute.net';
const areaServed = [
  'Raleigh, NC',
  'Durham, NC',
  'Chapel Hill, NC',
  'Cary, NC',
  'Garner, NC',
  'Research Triangle, NC',
].map((name) => ({ '@type': 'City', name }));

// Structured data via @graph — combines Organization, WebSite, ProfessionalService (a LocalBusiness subtype),
// and FAQPage. This helps Google entity/Knowledge Panel understanding AND AI engines (ChatGPT/Perplexity/Claude)
// extract answers. See the schema + ai-seo skills.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': siteUrl + '/#organization',
      name: 'Enclave Compute',
      url: siteUrl,
      logo: new URL('/logo.png', Astro.site).href,
      image: new URL('/logo.png', Astro.site).href,
      email: 'info@enclavecompute.net',
      description:
        'Local AI deployment for privacy-sensitive businesses. Your data never leaves your building.',
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@enclavecompute.net',
        contactType: 'sales',
        areaServed: ['US'],
      },
      // Add real social/profile URLs here as they exist (LinkedIn, GitHub, etc.)
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      '@id': siteUrl + '/#website',
      name: 'Enclave Compute',
      url: siteUrl,
      publisher: { '@id': siteUrl + '/#organization' },
    },
    {
      '@type': 'ProfessionalService',
      '@id': siteUrl + '/#service',
      name: 'Enclave Compute',
      description:
        'Local AI deployment for privacy-sensitive businesses. Your data never leaves your building.',
      url: siteUrl,
      email: 'info@enclavecompute.net',
      logo: new URL('/logo.png', Astro.site).href,
      image: new URL('/logo.png', Astro.site).href,
      priceRange: '$$',
      // NAP (name/address/phone) intentionally omitted until real contact details are ready.
      // Add address + geo here when you have confirmed business location info.
      areaServed: areaServed,
    },
    {
      '@type': 'FAQPage',
      '@id': siteUrl + '/#faq',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Why choose local AI instead of cloud AI?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Cloud AI sends your sensitive data to external servers. Enclave Compute keeps everything on a device in your office — so patient records, client files, and privileged communications never leave your network.',
          },
        },
        {
          '@type': 'Question',
          name: 'How does Enclave Compute deploy AI?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We start with a free 20-minute intro call, run a fixed-fee AI Readiness Assessment that audits your workflows and demos AI on your own data, then deploy a pre-configured on-premise device with staff training and go-live support — usually in under two weeks.',
          },
        },
        {
          '@type': 'Question',
          name: 'Who does Enclave Compute work with?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'We work with healthcare practices (dental, orthodontic, medical), law firms, and professional services such as accounting, consulting, and financial advisory — any business that handles sensitive data and wants AI without cloud risk.',
          },
        },
        {
          '@type': 'Question',
          name: 'Does local AI work offline?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Because the AI runs on hardware you own, it keeps working if the internet goes down — no cloud dependency means no outages, latency spikes, or downtime.',
          },
        },
      ],
    },
  ],
};
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Robots: index all pages, follow links -->
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Enclave Compute" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      // Set theme before first paint to avoid flash
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a href="/" class="logo"><span>⬡</span> Enclave Compute</a>
        <ul class="nav-links" id="nav-links">
          <li><a href="/#what-we-do">What We Do</a></li>
          <li><a href="/#how-it-works">How It Works</a></li>
          <li><a href="/#pii-guard">PII Guard</a></li>
          <li><a href="/#verticals">Verticals</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#contact" class="btn btn-primary" style="padding: 0.5rem 1.2rem; font-size: 0.85rem;">Book a Call</a></li>
        </ul>
        <div class="nav-controls">
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark and light mode" title="Toggle theme">
            <span class="icon-moon">🌙</span><span class="icon-sun">☀️</span>
          </button>
          <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">☰</button>
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <p>&copy; {new Date().getFullYear()} Enclave Compute LLC. All rights reserved.</p>
    </footer>

    <script is:inline>
      // Theme toggle
      const themeToggle = document.getElementById('theme-toggle');
      themeToggle?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });

      // Mobile nav toggle
      const navToggle = document.getElementById('nav-toggle');
      const navLinks = document.getElementById('nav-links');
      navToggle?.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('open');
        navToggle.setAttribute('aria-expanded', String(isOpen));
      });
      // Close menu when a link is clicked
      navLinks?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          navLinks.classList.remove('open');
          navToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
